{
    "name": "sellissimo/core",
    "description": "Sellissimo for Statamic 6.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "statamic/cms": "^6.0",
        "laravel/framework": "^12.40 || ^13.0",
        "ext-intl": "*",
        "ext-zip": "*",
        "brick/math": "^0.12 || ^0.13 || ^0.14 || ^0.15 || ^0.16 || ^0.17 || ^1.0"
    },
    "autoload": {
        "psr-4": {
            "Sellissimo\\Core\\": "src/"
        }
    },
    "extra": {
